{
  "info": {
    "name": "RideLink - Account Service API",
    "_postman_id": "7a30cf78-8fb3-4da2-a63e-f1b21908d1f2",
    "description": "Complete Postman collection for RideLink Account Service microservice demonstration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Passenger",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    pm.collectionVariables.set('userId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Kasun\",\n  \"lastName\": \"Perera\",\n  \"email\": \"kasun.perera@example.com\",\n  \"phoneNumber\": \"+94771234567\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register/passenger",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register", "passenger"]
            }
          }
        },
        {
          "name": "Register Driver",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    pm.collectionVariables.set('userId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Nimal\",\n  \"lastName\": \"Fernando\",\n  \"email\": \"nimal.fernando@example.com\",\n  \"phoneNumber\": \"+94779876543\",\n  \"password\": \"DriverPass@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register/driver",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register", "driver"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    pm.collectionVariables.set('userId', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kasun.perera@example.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Profile Management",
      "item": [
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "me"]
            }
          }
        },
        {
          "name": "Update Current Profile (Me)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Kasun\",\n  \"lastName\": \"Silva\",\n  \"phoneNumber\": \"+94770001122\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/accounts/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "me"]
            }
          }
        },
        {
          "name": "Get Account by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "{{userId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Admin Management",
      "item": [
        {
          "name": "Update Account Status (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SUSPENDED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{userId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "{{userId}}", "status"]
            }
          }
        },
        {
          "name": "Update Account Role (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"DRIVER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/accounts/{{userId}}/role",
              "host": ["{{baseUrl}}"],
              "path": ["api", "accounts", "{{userId}}", "role"]
            }
          }
        }
      ]
    }
  ]
}
